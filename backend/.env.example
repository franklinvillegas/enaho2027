# Copiar a .env y completar. El archivo .env NO se sube a Git.

DJANGO_SECRET_KEY=cambiar-por-una-clave-larga-y-aleatoria
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Base de monitoreo NUEVA (propia del sistema nuevo: usuarios, registro de uso, tablas
# resumen). En modo local (settings/local.py) no se usa: va a un SQLite.
DB_MONITOREO_NAME=ENAHO_MONITOREO
DB_MONITOREO_HOST=localhost
DB_MONITOREO_PORT=1433
DB_MONITOREO_USER=
DB_MONITOREO_PASSWORD=

# Base del sistema actual (SOLO LECTURA): donde están los procedimientos y los usuarios
# del monitoreo actual. Es la misma que usa monitoreo-enaho-v2 (settings/local.py).
# Ideal: un usuario de SQL Server con permisos solo de lectura y EXECUTE.
DB_ACTUAL_NAME=ENAHO2019_BDMONITOREO
DB_ACTUAL_HOST=
DB_ACTUAL_PORT=1433
DB_ACTUAL_USER=
DB_ACTUAL_PASSWORD=

# Driver ODBC instalado en la PC o servidor (el sistema actual usa el 17)
DB_ODBC_DRIVER=ODBC Driver 17 for SQL Server
DB_TRUST_SERVER_CERTIFICATE=yes

# Origen del frontend en desarrollo (Vite)
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173

# Login con los usuarios del sistema actual (solo lectura de su tabla de usuarios)
AUTENTICAR_CON_SISTEMA_ACTUAL=True
SISTEMA_ACTUAL_TABLA_USUARIOS=dbo.usuarios_usuario

# De dónde lee cada módulo mientras dura la migración: "sistema_actual" (procedimientos
# actuales), "monitoreo" (tablas resumen nuevas) o "demo" (datos inventados)
FUENTE_COBERTURA=sistema_actual
