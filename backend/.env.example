# Copiar a .env y completar. El archivo .env NO se sube a Git.

DJANGO_SECRET_KEY=cambiar-por-una-clave-larga-y-aleatoria
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Base de monitoreo (propia del sistema nuevo: usuarios, registro de uso, tablas resumen)
DB_MONITOREO_NAME=ENAHO_MONITOREO
DB_MONITOREO_HOST=localhost
DB_MONITOREO_PORT=1433
DB_MONITOREO_USER=
DB_MONITOREO_PASSWORD=

# Base de captura (SOLO LECTURA). Idealmente una réplica, no el servidor principal.
DB_CAPTURA_NAME=ENAHO2014_BDCAPTURA
DB_CAPTURA_HOST=
DB_CAPTURA_PORT=1433
DB_CAPTURA_USER=
DB_CAPTURA_PASSWORD=

# Driver ODBC instalado en el servidor
DB_ODBC_DRIVER=ODBC Driver 18 for SQL Server
DB_TRUST_SERVER_CERTIFICATE=yes

# Origen del frontend en desarrollo (Vite)
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173

# De dónde lee cada módulo mientras dura la migración: "captura" (procedimientos actuales)
# o "monitoreo" (tablas resumen nuevas)
FUENTE_COBERTURA=captura
